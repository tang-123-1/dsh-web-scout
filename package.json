{
  "name": "@local/web-scout",
  "version": "1.22.0",
  "private": true,
  "type": "module",
  "description": "给 DeepSeek Harness 的联网检索插件：46 个平台、热搜榜、证据包、MCP 服务。",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "web-search",
    "mcp",
    "mcp-server",
    "search-engine",
    "hot-list",
    "trend",
    "evidence-pack",
    "research-mode",
    "zhihu",
    "bilibili",
    "douyin",
    "toutiao",
    "v2ex",
    "csdn",
    "selftest"
  ],
  "license": "MIT",
  "author": "[YOUR_NAME]",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/[GITHUB_OWNER]/web-scout.git"
  },
  "homepage": "https://github.com/[GITHUB_OWNER]/web-scout#readme",
  "bugs": {
    "url": "https://github.com/[GITHUB_OWNER]/web-scout/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "smoke": "node scripts/smoke.mjs",
    "mcp": "node mcp/server.mjs",
    "selftest": "node scripts/selftest.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./mcp": "./mcp/server.mjs"
  },
  "files": [
    "index.js",
    "api.js",
    "store.js",
    "open.js",
    "engines.js",
    "net.js",
    "login.js",
    "browserCookies.js",
    "browserAuth.js",
    "cache.js",
    "client.js",
    "locale/zh.json",
    "locale/en.json",
    "icon.svg",
    "README.md",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "LICENSE",
    "scripts/smoke.mjs",
    "providers/registry.js",
    "providers/external.js",
    "providers/example-provider.mjs",
    "mcp/server.mjs",
    "scripts/selftest.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "bin": {
    "web-scout-mcp": "./mcp/server.mjs"
  }
}
